# TCS ERP — environment variables for the standalone Express server (server/index.ts).
# Copy to `.env` and fill in real values — `npm run dev` and `npm start` both read it. Variables
# already set in the real environment (e.g. by docker-compose) take precedence over `.env`.

# --- Required ---

# MongoDB connection string (Atlas SRV URI or self-hosted mongodb://...)
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority

# Secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs every user out (their cookies stop verifying).
JWT_SECRET=

# --- Production ---

# MUST be "production" on the real server: makes the session cookie `secure` (HTTPS-only)
# and disables the local-dev DNS resolver workaround in api/_lib/mongodb.ts.
NODE_ENV=production

# Port the Express server listens on (default 3001). Put nginx/Caddy with HTTPS in front of it.
PORT=3001

# Public base URL of the app — attachment capability-URLs are built from this.
# (2026-08-07: email sending was removed entirely — document recipients get in-app bell
# notifications only, so no email-related env vars exist anymore.)
APP_URL=https://erp.example.co.th

# --- LINE Official Account (optional — Service Report customer approval, 2026-08-10) ---

# From developers.line.biz → your Messaging API channel. Without them the approval feature still
# works: staff copy the approval link and send it themselves; only the automatic LINE push and
# the pairing webhook need these. The OA's Webhook URL must point at ${APP_URL}/api/line/webhook.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- LINE Official Account #2 (planned, not yet built — internal staff document notifications) ---

# Deliberately a SEPARATE OA/channel from the customer one above, not a shared one — keeps staff
# pairing codes from ever colliding with customer pairing codes on the same webhook. Create a
# second Messaging API channel at developers.line.biz for this. Its Webhook URL must point at
# ${APP_URL}/api/line/webhook/staff (route not implemented yet).
LINE_STAFF_CHANNEL_ACCESS_TOKEN=
LINE_STAFF_CHANNEL_SECRET=

# --- Docker stack only (docker compose — see docs/DEPLOYMENT.md "Docker") ---

# Root user/password for the MongoDB container. Created automatically on the FIRST boot of a
# fresh volume; the app's connection string is built from these inside docker-compose.yml
# (MONGODB_URI above is ignored there). Keep the password URL-safe: letters/digits only.
# Changing them after the first boot requires `docker compose down -v` (wipes data) or a manual
# password change in mongosh.
MONGO_USER=tcs_admin
MONGO_PASS=

# --- Optional overrides ---

# Database name (default: tcs_erp)
# MONGODB_DB=tcs_erp
